# Prisma / PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/coptdev?schema=public"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini AI — primary key for all AI features
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Fallback (scripts also accept this):
# GOOGLE_API_KEY=your_gemini_api_key_here

# AI generation config
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.7

# AI embedding config
EMBEDDING_MODEL=gemini-embedding-001

# Scaffolding defaults
DEFAULT_POST_TYPE=BLOG
DEFAULT_TEMPLATE=minimal
AUTO_GENERATE_OUTLINE=false
DEBUG=false

# iOS Shortcut ingest pipeline
# Shared bearer token the iOS Shortcut sends in `Authorization: Bearer ...`
INGEST_TOKEN=replace_me_with_a_long_random_hex_string
# Absolute path to a checkout of this repo that the worker uses as its git workspace
INGEST_REPO_PATH=/Users/you/workspaces/copt-dev-worker
# Where uploaded image bytes are staged before the worker commits them
INGEST_STAGING_DIR=/tmp/copt-ingest
# Worker poll interval (milliseconds)
INGEST_POLL_INTERVAL_MS=5000
