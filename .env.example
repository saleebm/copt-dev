# Prisma / PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/coptdev?schema=public"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini AI — primary key for all AI features
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Fallback (scripts also accept this):
# GOOGLE_API_KEY=your_gemini_api_key_here

# AI generation config
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.7

# AI embedding config
EMBEDDING_MODEL=gemini-embedding-001

# Scaffolding defaults
DEFAULT_POST_TYPE=BLOG
DEFAULT_TEMPLATE=minimal
AUTO_GENERATE_OUTLINE=false
DEBUG=false

# iOS Shortcut ingest pipeline
# Shared bearer token the iOS Shortcut sends in `Authorization: Bearer ...`
INGEST_TOKEN=replace_me_with_a_long_random_hex_string
# Absolute path to a checkout of this repo that the worker uses as its git workspace
INGEST_REPO_PATH=/Users/you/workspaces/copt-dev-worker
# Where uploaded image bytes are staged before the worker commits them
INGEST_STAGING_DIR=/tmp/copt-ingest
# Worker poll interval (milliseconds)
INGEST_POLL_INTERVAL_MS=5000

# iOS Shortcut review/merge API
# Bearer token for /api/review/* — falls back to INGEST_TOKEN when unset, so
# you can reuse the same secret in your Shortcuts. Override only if you want
# distinct access for the review surface.
REVIEW_TOKEN=
# Git checkout the review API uses for `gh pr` calls. Falls back to
# INGEST_REPO_PATH when unset. `gh auth status` must be green in this dir.
REVIEW_REPO_PATH=

# YouTube Data API v3 — used by the YouTube ingest branch for metadata/chapters.
# Get a key at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
# If unset, YouTube ingests fall back to transcript + Gemini-only enrichment.
YOUTUBE_DATA_API_KEY=

# Model used for the YouTube evidence call (Gemini-native video analysis via
# fileData.fileUri). Must support YouTube URIs — preview/experimental models
# routinely reject them with INVALID_ARGUMENT. Defaults to gemini-2.5-pro.
# The rest of the pipeline (url_context, notes, images, structuring) still
# uses AI_MODEL above.
YOUTUBE_AI_MODEL=gemini-2.5-pro

# YouTube chunking — long videos (≳2h at default resolution) blow past
# Gemini's 1M-token input window in a single call. The runner splits them
# into overlapping time windows, runs Gemini per window in parallel, then
# merges. Defaults work for talks/podcasts up to many hours.
YOUTUBE_CHUNK_SECONDS=2700        # 45 min per window
YOUTUBE_CHUNK_OVERLAP_SECONDS=60  # 1 min overlap to avoid cutting mid-sentence
YOUTUBE_CHUNK_PARALLEL=2          # max chunks in flight at once
