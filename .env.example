# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@localhost:5432/coptdev?schema=public"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini AI (for post scaffolding)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# OR (alternative name)
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: AI Configuration
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Optional: Scaffolding Defaults
DEFAULT_POST_TYPE=BLOG
DEFAULT_TEMPLATE=minimal
AUTO_GENERATE_OUTLINE=false
DEBUG=false
STAGEWISE_ENABLE=false
