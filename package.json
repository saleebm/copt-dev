    "lint-staged": "^17.0.4",
    "portless": "^0.13.0",
    "postcss": "^8.5.14",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "ultracite": "7.7.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
