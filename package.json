{
  "name": "copt-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:next": "NODE_ENV=development next dev",
    "dev:no-logs": "NODE_ENV=development next dev",
    "build": "NODE_ENV=production next build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy && bun run db:generate",
    "db:migrate:dev": "prisma migrate dev && bun run db:generate",
    "db:migrate:reset": "prisma migrate reset && bun run db:generate",
    "db:studio": "prisma studio",
    "db:sync-posts": "bun run --conditions=react-server scripts/sync-posts.ts",
    "db:sync-posts:dry": "bun run --conditions=react-server scripts/sync-posts.ts --dry-run --verbose",
    "dev:sync": "bun --watch --conditions=react-server scripts/dev-sync-posts.ts",
    "scaffold": "bun run scripts/scaffold-post-v2.ts",
    "new-post": "bun run scripts/scaffold-post-v2.ts",
    "codemods": "bun run scripts/run-codemods.ts",
    "codemods:dry": "bun run scripts/run-codemods.ts --dry-run --verbose",
    "consolidate:categories": "bun run scripts/consolidate-findings-categories.ts",
    "consolidate:categories:execute": "bun run scripts/consolidate-findings-categories.ts --execute",
    "deduplicate": "bun run scripts/deduplicate-posts.ts",
    "deduplicate:execute": "bun run scripts/deduplicate-posts.ts --execute",
    "deduplicate:verbose": "bun run scripts/deduplicate-posts.ts --verbose",
    "consolidate:tags": "bun run scripts/consolidate-tags-embeddings.ts",
    "consolidate:tags:execute": "bun run scripts/consolidate-tags-embeddings.ts --execute",
    "consolidate:tags:clear": "bun run scripts/consolidate-tags-embeddings.ts --clear-cache",
    "db:migrate:create": "prisma migrate dev --create-only --name",
    "start": "NODE_ENV=production next start",
    "lint": "biome check .",
    "lint:check": "biome check . --max-diagnostics=50",
    "lint:fix": "biome check . --write",
    "lint:fix:unsafe": "biome check . --write --unsafe",
    "typecheck": "tsc --noEmit",
    "test:scroll": "playwright test tests/post-stack-scroll.spec.ts",
    "test:e2e": "playwright test",
    "records:validate": "bun run scripts/validate-records.ts",
    "extract:tiddlers": "bun run scripts/tiddler-extraction/extract.ts",
    "extract:tiddlers:dry": "bun run scripts/tiddler-extraction/extract.ts --dry-run --verbose",
    "extract:tiddlers:scaffold": "bun run scripts/tiddler-extraction/extract.ts --scaffold",
    "roll": "bun run scripts/roll/roll.ts",
    "roll:dry": "bun run scripts/roll/roll.ts --dry-run",
    "ingest:setup": "bun run scripts/setup-ingest.ts",
    "worker": "bun run scripts/ingest-worker.ts",
    "worker:dev": "bun --watch scripts/ingest-worker.ts",
    "deploy": "bash scripts/deploy-remote.sh"
  },
