// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  content         String
  excerpt         String?
  type            PostType
  status          PostStatus      @default(DRAFT)
  filePath        String
  fileHash        String
  findingsCount   Int?
  originalDate    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastEdited      DateTime        @updatedAt
  published       Boolean         @default(false)

  // Provider provenance — tracks where this post came from
  sourceType      String          @default("mdx") // "mdx" | "json" | "api"
  providerId      String          @default("filesystem") // provider identifier
  sourceRecordId  String?         // external/provider-specific record id
  sourceHash      String?         // hash of the source record for change detection
  syncStatus      String          @default("synced") // "synced" | "pending" | "error" | "tombstone"
  lastSyncedAt    DateTime?

  tags            Tag[]           @relation("PostToTag")
  categories      Category[]      @relation("PostToCategory")
  hlexiconEntries HlexiconEntry[] @relation("PostToHlexicon")

  @@unique([providerId, slug]) // prevent cross-provider slug collisions
  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([published])
  @@index([providerId])
  @@index([syncStatus])
}

enum PostType {
  CONCRETE
  BLOG
  FINDING
  SIGHT
}

enum PostStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostToTag")

  @@index([slug])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique // Keep as kebab-case to match embeddings
  displayName String // ADD: Human-readable name
  slug        String @unique
  posts       Post[] @relation("PostToCategory")

  @@index([slug])
  @@index([name]) // ADD: Index for faster joins
}

model HlexiconEntry {
  id         String   @id @default(cuid())
  term       String   @unique
  definition String
  posts      Post[]   @relation("PostToHlexicon")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([term])
}

model CategoryEmbedding {
  id             String   @id @default(cuid())
  path           String   @unique // Full category path (e.g., "ai-tools/developer-tools/llmops")
  name           String // Category name (e.g., "llmops")
  fullPath       String // Absolute file system path
  parentPath     String? // Parent category path (null for top-level)
  depth          Int // Nesting depth (0 = top-level)
  fileCount      Int // Number of MDX files in this category
  description    String // Generated description used for embedding
  embedding      Float[] // Vector embedding (stored as array of floats)
  embeddingHash  String // Hash of the description to detect changes
  modelVersion   String // Model version used for embedding (e.g., "text-embedding-004")
  dimensionality Int // Embedding vector size (e.g., 256)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([path])
  @@index([parentPath])
  @@index([depth])
  @@index([embeddingHash])
}

model IngestSubmission {
  id             String    @id @default(cuid())
  kind           String    // "url" | "image" | "note"
  payload        Json      // raw normalized request payload
  contentHash    String    @unique // dedup key; force=true salts the hash
  batchId        String?   // groups image rows that should become one SIGHT post
  imageIndex     Int?
  totalCount     Int?
  stagedFilePath String?   // absolute path to staged binary on the host
  status         String    @default("pending") // "pending" | "processing" | "completed" | "failed" | "skipped"
  attempts       Int       @default(0)
  errorMessage   String?
  resultPostSlug String?
  resultPrUrl    String?
  resultBranch   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt   DateTime?

  @@index([status])
  @@index([batchId])
  @@index([kind])
}

model TagEmbedding {
  id             String   @id @default(cuid())
  name           String   @unique // Tag name (e.g., "open-source")
  description    String // Generated description used for embedding
  embedding      Float[] // Vector embedding (stored as array of floats)
  embeddingHash  String // Hash of the description to detect changes
  modelVersion   String // Model version used for embedding (e.g., "gemini-embedding-001")
  dimensionality Int // Embedding vector size (e.g., 256)
  postCount      Int // Number of posts using this tag
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([embeddingHash])
}
